# Local node; the default is http://127.0.0.1:8545.
LOCAL_RPC_URL=http://127.0.0.1:8545

# Required only for a Sepolia deployment. Never commit the real values.
SEPOLIA_RPC_URL=https://sepolia.example-provider.invalid/v3/YOUR_API_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Optional comma-separated addresses to authorize immediately after deployment.
# Every lab is automatically granted CUSTODIAN_ROLE as well.
LAB_ADDRESSES=
CUSTODIAN_ADDRESSES=
